# ---------------------------------------------------------------------------
# Application-level secrets only. Tenant integration credentials (Samsara,
# Airtable, ...) are NEVER stored here; they live encrypted per tenant in the
# `integrations` table (see APP_ENCRYPTION_KEY).
# ---------------------------------------------------------------------------

# Deployment tier: development | staging | production (defaults from NODE_ENV).
# staging = real Supabase + production build, but CAPTCHA may be disabled with a warning.
APP_ENV=development

# Postgres connection used by the app server. Must be a role WITHOUT bypassrls
# (see supabase/README.md). Locally: scripts/local-db.sh creates `app_service`.
DATABASE_URL=postgres://app_service:app_service@localhost:54329/tire_check

# Supabase project (admin auth + Storage). Optional for local dev.
# On Vercel the Supabase integration provides these automatically; the app also
# accepts SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_PUBLISHABLE_KEY,
# POSTGRES_URL (transaction pooler) and the legacy SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only privileged key (sb_secret_…). Never exposed to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=inspection-photos

# Where photos go when Supabase Storage is not configured (development only).
LOCAL_STORAGE_DIR=.data/storage

# 32-byte hex key for AES-256-GCM encryption of tenant integration credentials.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Secret for signing driver session cookies. Generate: openssl rand -hex 32
DRIVER_SESSION_SECRET=dev-only-change-me-dev-only-change-me

# Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is empty in development the
# check is skipped (logged loudly). In production it is REQUIRED.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: AI photo analysis provider (Phase 3). Leave empty to disable.
# Canonical public origin (optional). On Vercel production deployments the project's
# production URL is used automatically and other aliases redirect to it; set this only
# for a custom domain or when running behind a proxy.
NEXT_PUBLIC_APP_URL=

ANTHROPIC_API_KEY=
